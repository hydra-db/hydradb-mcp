# HydraDB MCP Server — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# HydraDB API Key (required)
# Get yours at https://app.hydradb.com
HYDRADB_API_KEY=your-api-key-here

# HydraDB Database — the tenant scope (required)
# Found on your Hydra DB dashboard
HYDRADB_DATABASE=your-database-here

# Collection — sub-tenant scope for data partitioning (optional, defaults to "hydra-db-mcp")
# Use this to isolate data across different projects or environments
# HYDRADB_COLLECTION=hydra-db-mcp

# Base URL override (optional; defaults to https://api.hydradb.com)
# HYDRADB_BASE_URL=https://api.hydradb.com

# Log level: DEBUG, INFO, WARN, ERROR (optional, defaults to ERROR)
# HYDRADB_LOG_LEVEL=ERROR

# The legacy HYDRA_DB_* names are still honoured as deprecated aliases
# (HYDRA_DB_API_KEY, HYDRA_DB_TENANT_ID, HYDRA_DB_SUB_TENANT_ID, HYDRA_DB_BASE_URL,
# HYDRA_DB_LOG_LEVEL); using one prints a one-time warning naming its canonical
# replacement.

# --- Remote HTTP transport (optional) ---
# These apply ONLY to the hosted HTTP server (`npm run start:http` /
# `node dist/http.js` / the Docker image). The stdio (npx) server ignores them.
#
# When self-hosting a SINGLE tenant, set HYDRADB_API_KEY + HYDRADB_DATABASE above
# and every request uses them. When hosting for MANY users (e.g. mcp.hydradb.com),
# leave those unset: each request must then carry its own credentials in headers
# (`Authorization: Bearer <api-key>` and `X-HydraDB-Database: <database>`), and a
# request without them is refused (401/400).

# Port to listen on (optional, defaults to 8080).
# PORT=8080

# Interface to bind (optional, defaults to 127.0.0.1 — loopback only).
# Set to 0.0.0.0 to accept connections from outside the host. Do this only
# behind TLS with ALLOWED_HOSTS/ALLOWED_ORIGINS set. See SECURITY.md.
# BIND_ADDRESS=0.0.0.0

# Extra Host headers to accept, comma-separated (optional). Loopback is always
# allowed; add your public hostname when binding to 0.0.0.0.
# ALLOWED_HOSTS=mcp.hydradb.com

# CORS: browser origins allowed to call the server, comma-separated (optional).
# Empty rejects all cross-origin browser requests. "*" allows any (logs a
# warning). Non-browser clients (no Origin header) are always allowed.
# ALLOWED_ORIGINS=https://app.hydradb.com

# Trust proxy (optional, default off). When the server runs behind a reverse
# proxy/load balancer, set this so the real client IP is recovered from
# X-Forwarded-For. A hop count (e.g. 1), "true", or a preset like "loopback".
# Leave off if the server is reached directly. See SECURITY.md.
# TRUST_PROXY=1

# Set to "true" to run live integration tests against Hydra DB (optional)
# RUN_LIVE_TESTS=true

# Per-attempt request timeout in seconds (optional, defaults to 30)
# HYDRADB_TIMEOUT_SECONDS=30

# Retries per request (optional, defaults to 2; 0 disables retrying)
# HYDRADB_MAX_RETRIES=2

# Register the deprecated hydra_db_* tool aliases (optional, default off).
# Set to 1 only if your mcp.json still calls the old tool names.
# HYDRADB_MCP_LEGACY_TOOLS=1

# --- Graph (BYOG) tools ---
# HydraDB also runs property graphs you model and own end to end, queried in
# Cypher. These are a SEPARATE store from the memory/knowledge corpora above:
# hydradb_query cannot see graph data, and hydradb_graph_query cannot see
# memories. See https://docs.hydradb.com/essentials/v2/graph-collections-byog

# Default graph database (optional; falls back to HYDRADB_DATABASE).
# A graph database is a different namespace from the memory database — a query
# aimed at the wrong one reads an empty graph rather than failing.
# HYDRADB_GRAPH_DATABASE=your-graph-database

# Default graph collection (optional, defaults to "default").
# Each collection is an independent graph; a query sees exactly one.
# HYDRADB_GRAPH_COLLECTION=default

# Withhold the three graph tools entirely (optional, default on).
# Set to 0 if you only use the memory/knowledge tools and do not want the
# extra tool definitions in every conversation.
# HYDRADB_MCP_GRAPH_TOOLS=0
